# ===================================================
# Sokone 環境変数テンプレート
# ===================================================
# このファイルをコピーして .env.local を作成してください:
#   cp .env.example .env.local
#
# Prisma CLI 用に .env も作成してください（DATABASE_URL のみ必要）:
#   cp .env.example .env
# ===================================================

# --------------------------------------------------
# Database (Neon — 開発・本番共用)
# --------------------------------------------------
# Neon Console (https://console.neon.tech) でプロジェクト作成後、接続文字列をコピー
# WebSocket 接続のため ?sslmode=require を付ける
DATABASE_URL="postgresql://user:password@ep-xxx.region.neon.tech/neondb?sslmode=require"

# --------------------------------------------------
# NextAuth.js
# --------------------------------------------------
# NEXTAUTH_URL: 開発時は http://localhost:3000、本番は実際のURL
# NEXTAUTH_SECRET: `openssl rand -base64 32` で生成
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# --------------------------------------------------
# Google OAuth
# --------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials で OAuth 2.0 クライアントIDを作成
# リダイレクトURI: http://localhost:3000/api/auth/callback/google (開発)
#                  https://your-domain.vercel.app/api/auth/callback/google (本番)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --------------------------------------------------
# Gemini AI (OCR / カテゴリ自動設定)
# --------------------------------------------------
# Google AI Studio (https://aistudio.google.com/apikey) で APIキーを取得
# 無料枠: 1日1,500リクエスト / 1分15リクエスト
GEMINI_API_KEY="your-gemini-api-key"

# --------------------------------------------------
# Cloudflare R2 (画像ストレージ)
# --------------------------------------------------
# Cloudflare Dashboard > R2 Object Storage で設定
# 無料枠: 10GB ストレージ / 月
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="sokone-images"
R2_PUBLIC_URL="https://your-r2-public-url"

# --------------------------------------------------
# Vercel Cron (自動スクレイピング保護)
# --------------------------------------------------
# `openssl rand -base64 32` または PowerShell で生成:
#   $b = New-Object byte[] 32; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)
# Vercel Dashboard > Settings > Environment Variables にも同じ値を設定すること
CRON_SECRET="your-cron-secret-here"

# --------------------------------------------------
# Resend (メール送信)
# --------------------------------------------------
# Resend (https://resend.com) でアカウント作成後、APIキーを取得
# 無料枠: 3,000通/月、1日100通
# EMAIL_FROM: 独自ドメイン設定前は "onboarding@resend.dev" を使用可能
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Sokone <noreply@sokone.app>"
